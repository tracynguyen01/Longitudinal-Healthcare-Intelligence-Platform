import json
from pprint import pprint

# Load patient data
with open("../data/synthetic_patients/patient_001.json", "r") as f:
    patient_data = json.load(f)

pprint(patient_data)

print("\n=== PATIENT TIMELINE ===\n")

for visit in patient_data["visits"]:
    print(f"Date: {visit['visit_date']}")
    print(f"Symptoms: {', '.join(visit['symptoms'])}")
    print(f"Blood Pressure: {visit['blood_pressure']}")
    print(f"Clinical Note: {visit['clinical_note']}")
    print("-" * 50)

neurological_keywords = [
    "headache",
    "dizziness",
    "blurred vision",
    "balance issues"
]

detected = []

for visit in patient_data["visits"]:
    for symptom in visit["symptoms"]:
        for keyword in neurological_keywords:
            if keyword.lower() in symptom.lower():
                detected.append({
                    "date": visit["visit_date"],
                    "symptom": symptom
                })

print("\n=== DETECTED NEUROLOGICAL PROGRESSION ===\n")

for item in detected:
    print(f"{item['date']} → {item['symptom']}")
